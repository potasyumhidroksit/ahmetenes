---
// Gizlilik dostu ziyaret sayaci (/api/analytics); her iki yerlesim de kullanir.
interface Props {
	/** 404 sayfasi: ziyaret sayilmaz, kirik baglanti olarak kaydedilir */
	notFound?: boolean;
}

const { notFound = false } = Astro.props;
---

<script is:inline define:vars={{ notFound }}>
  try {
    // Otomasyon (Lighthouse, headless test) ziyaret sayilmaz. 404'te yol +
    // geldigi sitenin adi (referrer) kirik baglanti olarak gider.
    if (location.pathname.indexOf("/_emdash") !== 0 && !navigator.webdriver) {
      var hit = notFound ? { path: location.pathname, missing: true, ref: document.referrer } : { path: location.pathname };
      fetch("/api/analytics", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(hit), keepalive: true }).catch(function () {});
    }
  } catch (e) {}
</script>
