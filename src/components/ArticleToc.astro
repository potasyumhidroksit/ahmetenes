---
import { localeFromUrl, translate } from "../utils/i18n";

// "Bu yazida": 4+ ara baslikli yazida acilir icindekiler (kimlikler
// ArticleBlock'ta ayni headingId ile verilir).
interface Props {
	toc: { id: string; text: string }[];
}

const { toc } = Astro.props;
const t = (text: string) => translate(localeFromUrl(Astro.url), text);
---

<details class="article-toc">
	<summary>
		<span>{t("Bu yazıda")}</span>
		<span class="article-toc-count">{toc.length} bölüm</span>
	</summary>
	<ol>
		{toc.map((item) => (
			<li><a href={"#" + item.id}>{item.text}</a></li>
		))}
	</ol>
</details>

<style>
  /* "Bu yazida": kapali gelir, okuma sutunu genisliginde; okuma sirasi kutulariyla ayni dil. */
  .article-toc {
    max-width: 680px; margin: 0 0 40px;
    border: 1px solid var(--glass-border-active); border-radius: var(--radius-lg, 12px);
  }
  .article-toc summary {
    display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 10px 18px;
    cursor: pointer; list-style: none; font-weight: 500; color: var(--color-text);
  }
  .article-toc summary::-webkit-details-marker { display: none; }
  .article-toc summary::after {
    content: ""; width: 8px; height: 8px; margin-left: auto; margin-right: 4px;
    border: solid var(--color-text-secondary); border-width: 0 1.5px 1.5px 0;
    transform: translateY(-2px) rotate(45deg); transition: transform 0.2s ease;
  }
  .article-toc[open] summary::after { transform: translateY(2px) rotate(-135deg); }
  .article-toc summary:focus-visible { outline: 2px solid light-dark(#536163, #ccd7df); outline-offset: 3px; border-radius: var(--radius-lg, 12px); }
  .article-toc-count { font-size: 0.8125rem; font-weight: 400; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .article-toc ol { display: grid; gap: 4px; margin: 0; padding: 0 18px 16px 44px; font-variant-numeric: tabular-nums; }
  .article-toc li { padding-left: 4px; color: var(--color-muted); }
  .article-toc a { display: inline-block; padding: 3px 0; color: var(--color-text-secondary); text-decoration: none; line-height: 1.45; }
  .article-toc a:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.article-toc)) { scroll-behavior: smooth; }
  }
  @media (prefers-reduced-motion: reduce) { .article-toc summary::after { transition: none; } }
  @media print { .article-toc { display: none; } }
</style>
