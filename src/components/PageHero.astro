---
// Sayfa ustu genis fotograf + acik lisans atfi (Hakkimda, Su an, Iletisim,
// Ekipman). Gorsel public/blog/sayfa-<ad>/cover.webp; atif image-credits.json.
import ResponsiveImage from "./ResponsiveImage.astro";
import ImageCredit from "./ImageCredit.astro";
import { localImage } from "../lib/responsive-image";

interface Props {
	src: string;
	alt: string;
}

const { src, alt } = Astro.props;
const local = localImage(src);
---
{local && (
	<figure class="page-hero">
		<div class="page-hero-frame">
			<ResponsiveImage image={src} alt={alt} sizes="(max-width: 736px) calc(100vw - 76px), min(1160px, calc(100vw - 128px))" priority />
		</div>
		<figcaption><ImageCredit image={src} /></figcaption>
	</figure>
)}

<style>
	.page-hero { margin: 0 0 40px; }
	.page-hero-frame {
		aspect-ratio: 21 / 8;
		border-radius: 20px;
		overflow: hidden;
		background: var(--color-surface);
	}
	.page-hero-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
	.page-hero figcaption { margin-top: 10px; }
	@media (max-width: 736px) {
		.page-hero { margin-bottom: 28px; }
		.page-hero-frame { aspect-ratio: 16 / 9; border-radius: 14px; }
	}
</style>
