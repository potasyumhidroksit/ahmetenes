---
import Base from "../layouts/Content.astro";
import PostCard from "./PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { localeFromUrl } from "../utils/i18n";
import { localizeTurkish } from "../utils/turkish-content";
import type { TermArchiveData } from "../utils/term-archive";

// Kategori ve etiket arsivlerinin ortak gorunumu; metinler sayfadan gelir.
interface Props {
	archive: TermArchiveData;
	title: string;
	description: string;
	label: string;
	empty: string;
}

const { archive, title, description, label, empty } = Astro.props;
const locale = localeFromUrl(Astro.url);
const { term, posts } = archive;
---

<Base title={title} description={description} robots={posts.length < 2 ? "noindex, follow" : undefined}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">{label}</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{`${posts.length} ${locale === "en" && posts.length === 1 ? "post" : "yazı"}`}
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="no-posts">{empty}</p>
			) : (
				<div class="posts-grid">
					{posts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: locale === "tr" ? localizeTurkish(t.label) : t.label }))}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
