---
import { Font } from "astro:assets";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/personabio.css";
import "../styles/appearance.css";
import AppearanceHead from "../components/AppearanceHead.astro";
import SiteFavicon from "../components/SiteFavicon.astro";
import AnalyticsBeacon from "../components/AnalyticsBeacon.astro";
import { localeFromUrl } from "../utils/i18n";
interface Props { title: string; siteName?: string; description?: string; demo?: boolean; content?: {collection:string; id:string; slug?:string} }
const {title, siteName = title, description, content, demo = false} = Astro.props;
// Kanonik URL ve varsayılan paylaşım görseli.
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const ogImage = Astro.url.origin + "/og-default.jpg";
const page = createPublicPageContext({Astro, kind: content ? "content" : "custom", pageType:"website", siteName, title, description, canonical, image: ogImage, content, seo: demo ? {robots:"noindex, nofollow"} : { ogImage }});
---
<!doctype html>
<html lang={localeFromUrl(Astro.url)} data-public-theme="personabio-bio" data-appearance="dark">
  <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><SiteFavicon/><AppearanceHead/><title>{title}</title><Font cssVariable="--font-personabio" preload={[{ weight: 400, style: "normal" }]} /><EmDashHead page={page}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`${siteName} — fotoğraf ve notlar`}/><meta name="twitter:image:alt" content={`${siteName} — fotoğraf ve notlar`}/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Person","@id":Astro.url.origin + "/#person","name":"Ahmet Enes","jobTitle":"Fotoğrafçı","url":Astro.url.origin,"image":Astro.url.origin + "/avatar.webp","sameAs":["https://instagram.com/eneswideshut"]})} /></head>
  <body><EmDashBodyStart page={page}/><slot/><EmDashBodyEnd page={page}/><AnalyticsBeacon /></body>
</html>
