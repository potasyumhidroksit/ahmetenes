---
import { notFound } from "../utils/http";
import { resolveShortLink, shortLinkRedirect } from "../utils/short-link";
import { decodeSlug } from "emdash";
import { localizedEntry } from "../utils/localized-content";
import { localeFromUrl } from "../utils/i18n";
import Page from "./pages/[slug].astro";
import Post from "./posts/[slug].astro";

const locale = localeFromUrl(Astro.url);
const slug = decodeSlug(Astro.params.slug);
if (!slug) return notFound(Astro);

// Pages take precedence when a page and a post share the same slug.
const page = await localizedEntry("pages", slug, { locale });
if (Astro.cache?.enabled) Astro.cache.set(page.cacheHint);
let postExists = false;
if (!page.entry) {
  const post = await localizedEntry("posts", slug, { locale });
  if (Astro.cache?.enabled) Astro.cache.set(post.cacheHint);
  postExists = Boolean(post.entry);
}
if (!page.entry && !postExists) {
  // Sayfa/yazı değilse kısa link olabilir (ahmetenes.com/ne-izlesem → 9816-links).
  const target = await resolveShortLink(slug);
  if (target) return shortLinkRedirect(target);
  return notFound(Astro);
}
---
{page.entry ? <Page /> : <Post />}
