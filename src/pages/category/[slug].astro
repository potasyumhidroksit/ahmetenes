---
import { decodeSlug } from "emdash";
import TermArchive from "../../components/TermArchive.astro";
import { notFound } from "../../utils/http";
import { localeFromUrl, translate } from "../../utils/i18n";
import { archiveDescription, loadTermArchive } from "../../utils/term-archive";
const locale = localeFromUrl(Astro.url);
const archive = await loadTermArchive("category", decodeSlug(Astro.params.slug), locale);

if (!archive) {
	return notFound(Astro);
}

if (Astro.cache?.enabled) Astro.cache.set(archive.cacheHint);
const { label } = archive.term;
---

<TermArchive
	archive={archive}
	title={locale === "tr" ? `${label} yazıları` : `${label} posts`}
	description={locale === "tr" ? archiveDescription(archive, "kategorisindeki") : `Posts in ${label}`}
	label={translate(locale, "Kategori")}
	empty={translate(locale, "Bu kategoride henüz yazı yok.")}
/>
