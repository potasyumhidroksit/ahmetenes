---
import Content from "../layouts/Content.astro";
import { exifLine, loadGallery, galleryCategories } from "../lib/gallery";
import { postSlugsByPhoto } from "../lib/blog-photo";
import { localizedPosts } from "../utils/localized-posts";

export const prerender = false;

const photos = await loadGallery();
// Karenin gectigi yazi (varsa): lightbox'ta "Yazıda: ..." baglantisi.
const { entries: posts } = await localizedPosts("tr", { orderBy: { published_at: "desc" } });
const titleBySlug = new Map(posts.map((post) => [post.id, post.data.title]));
const slugsByPhoto = postSlugsByPhoto();
const postFor = (id: string) => {
  const slug = (slugsByPhoto.get(id) ?? []).find((s) => titleBySlug.has(s));
  return slug ? { href: "/" + slug, title: titleBySlug.get(slug) ?? "" } : null;
};
const srcset = (p: (typeof photos)[number]) => p.srcSet.map((s) => s.src + " " + s.w + "w").join(", ");
const origin = Astro.url.origin;
const year = new Date().getFullYear();
// Google Gorseller: yaratici/telif/kredi bilgisiyle kareler (image metadata).
const creator = { "@type": "Person", "@id": origin + "/#person", name: "Ahmet Enes", url: origin };
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Galeri — Ahmet Enes",
  url: origin + "/galeri",
  author: creator,
  image: photos.map((p) => ({
    "@type": "ImageObject",
    contentUrl: origin + p.fullSrc,
    thumbnailUrl: origin + p.src,
    url: origin + "/galeri/" + p.id,
    name: p.title,
    ...(p.story ? { description: p.story } : {}),
    // contentUrl 1600px genislige olceklenmis onizleme; boyutlar ona gore.
    ...(p.width && p.height
      ? { width: Math.min(1600, p.width), height: Math.round((Math.min(1600, p.width) * p.height) / p.width) }
      : {}),
    ...(p.location ? { contentLocation: { "@type": "Place", name: p.location } } : {}),
    creator,
    creditText: "Ahmet Enes",
    copyrightHolder: creator,
    copyrightNotice: "© " + (p.year || year) + " Ahmet Enes",
  })),
};
const cover = photos.find((p) => p.featured) ?? photos[0];
// Karesi olmayan kategori cipi gosterilmez (bos sonuc); ciplerde kare sayisi.
const countFor = (id: string) => (id === "tumu" ? photos.length : photos.filter((p) => p.category === id).length);
const filters = galleryCategories.map((cat) => ({ ...cat, count: countFor(cat.id) })).filter((cat) => cat.count > 0);
// Ziyaretciye anlamli alt baslik: "sehir, sokak, doga, portre ve gece".
const themeNames = filters.filter((cat) => cat.id !== "tumu").map((cat) => cat.label.toLocaleLowerCase("tr-TR"));
const themes = themeNames.length > 1 ? themeNames.slice(0, -1).join(", ") + " ve " + themeNames.at(-1) : themeNames[0] ?? "";
// Lightbox: ekran genisligine gore 800-1600px (mobilde 1600px indirmesin).
const fullSrcset = (p: (typeof photos)[number]) =>
  p.srcSet.filter((s) => s.w >= 800).map((s) => s.src + " " + s.w + "w").join(", ");
---
<Content title="Galeri" description={`Fotoğraf portfolyosu: ${themes || "şehir ve sokak"} kareleri. Her karenin çekim bilgisi (gövde, objektif, diyafram), konumu ve kısa hikâyesiyle.`} image={cover ? origin + "/api/immich/preview/" + cover.id + "?fmt=og" : undefined} imageAlt={cover?.alt ?? cover?.title} jsonLd={jsonLd}>
  <section class="archive-section gallery-page">
    <header class="archive-header">
      <h1>Galeri</h1>
      <p>{photos.length} kare{themes && " · " + themes}</p>
    </header>
    <div class="gallery-filters" role="group" aria-label="Kategori filtresi">
      {filters.map((cat) => (
        <button type="button" data-filter={cat.id} aria-pressed={cat.id === "tumu" ? "true" : "false"}>
          {cat.label} <span class="gallery-filter-count">{cat.count}</span>
        </button>
      ))}
    </div>
    <div class="gallery-grid" data-gallery>
      {photos.map((p, index) => (
        <a
          href={"/galeri/" + p.id}
          id={"kare-" + p.id}
          class="gallery-item"
          data-gallery-item
          data-category={p.category}
          data-full={p.fullSrc}
          data-full-srcset={fullSrcset(p)}
          data-title={p.title}
          data-exif={exifLine(p)}
          data-location={p.location}
          data-year={p.year}
          data-story={p.story}
          data-post-href={postFor(p.id)?.href}
          data-post-title={postFor(p.id)?.title}
          data-ar={p.width && p.height ? (p.width / p.height).toFixed(4) : undefined}
          style={[p.width && p.height ? "aspect-ratio: " + p.width + " / " + p.height + "; --ar: " + (p.width / p.height).toFixed(4) : "", p.color ? "background-color: " + p.color : ""].filter(Boolean).join("; ") || undefined}
        >
          <img
            src={p.src}
            srcset={srcset(p)}
            sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1100px) 45vw, 380px"
            alt={p.alt ?? p.title}
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
            decoding="async"
            {...(p.width && p.height ? { width: p.width, height: p.height } : {})}
          />
          <span class="gallery-item-caption" aria-hidden="true">{p.title}</span>
        </a>
      ))}
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Galeri önizleme">
    <button type="button" class="lightbox-close button-scrim" data-lightbox-close aria-label="Kapat">×</button>
    <figure>
      <div class="lightbox-stage">
        <img data-lightbox-img src="" alt="" sizes="(max-width: 1100px) 94vw, 1100px" />
        <button type="button" class="lightbox-nav lightbox-prev button-scrim" data-lightbox-prev aria-label="Önceki kare">‹</button>
        <button type="button" class="lightbox-nav lightbox-next button-scrim" data-lightbox-next aria-label="Sonraki kare">›</button>
      </div>
      <figcaption>
        <span class="lightbox-count" data-lightbox-count></span>
        <strong data-lightbox-title></strong>
        <span data-lightbox-meta></span>
        <p data-lightbox-story></p>
        <div class="lightbox-actions">
          <a class="lightbox-post" data-lightbox-post hidden></a>
          <button type="button" class="lightbox-share" data-lightbox-share aria-live="polite">Paylaş</button>
        </div>
      </figcaption>
    </figure>
  </dialog>
</Content>

<script>
  import { flashLabel, shareOrCopy } from "../scripts/share";

  // Kareler /galeri/<id> baglantisidir (JS'siz, yeni sekmede acma, tarayicilar);
  // normal tiklama lightbox'i acar.
  const items = document.querySelectorAll<HTMLAnchorElement>("[data-gallery-item]");
  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter || "tumu";
      document.querySelectorAll("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      items.forEach((item) => {
        item.hidden = !(filter === "tumu" || item.dataset.category === filter);
      });
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const title = dialog.querySelector<HTMLElement>("[data-lightbox-title]");
    const meta = dialog.querySelector<HTMLElement>("[data-lightbox-meta]");
    const story = dialog.querySelector<HTMLElement>("[data-lightbox-story]");
    const count = dialog.querySelector<HTMLElement>("[data-lightbox-count]");
    const postLink = dialog.querySelector<HTMLAnchorElement>("[data-lightbox-post]");
    const sizes = img?.getAttribute("sizes") || "100vw";
    const visibleItems = () => Array.from(items).filter((el) => !el.hidden);
    let current = -1;
    let lastFocus: HTMLElement | null = null;

    // Komsu kareleri arka planda isit: ok/kaydirma aninda gecsin.
    const preload = (item?: HTMLAnchorElement) => {
      if (!item) return;
      const pre = new Image();
      pre.sizes = sizes;
      if (item.dataset.fullSrcset) pre.srcset = item.dataset.fullSrcset;
      pre.src = item.dataset.full || "";
    };

    const fill = (item: HTMLAnchorElement) => {
      if (!img || !title || !meta || !story) return;
      // Adres cubugu karenin kendi sayfasi (/galeri/<id>): kopyalanan baglanti
      // o karenin onizlemesiyle paylasilir. Eski #kare-<id> baglantilari da acar.
      history.replaceState(null, "", "/galeri/" + item.id.replace(/^kare-/, ""));
      // Oran CSS'e: görsel ekrana kendi oranıyla sığar, dikey kare geniş ekranda bilgiyi yanına alır.
      const ar = Number(item.dataset.ar);
      if (ar > 0) { dialog.style.setProperty("--ar", String(ar)); dialog.dataset.orient = ar < 1 ? "portrait" : "landscape"; }
      else { dialog.style.removeProperty("--ar"); delete dialog.dataset.orient; }
      img.srcset = item.dataset.fullSrcset || "";
      img.src = item.dataset.full || "";
      img.alt = item.dataset.title || "";
      title.textContent = item.dataset.title || "";
      meta.textContent = [item.dataset.exif, item.dataset.location, item.dataset.year].filter(Boolean).join(" · ");
      story.textContent = item.dataset.story || "";
      if (postLink) {
        postLink.hidden = !item.dataset.postHref;
        postLink.href = item.dataset.postHref || "";
        postLink.textContent = item.dataset.postTitle ? "Yazıda: " + item.dataset.postTitle + " →" : "";
      }
      const list = visibleItems();
      if (count) count.textContent = list.length > 1 ? `${current + 1} / ${list.length}` : "";
      if (list.length > 1) {
        preload(list[(current + 1) % list.length]);
        preload(list[(current - 1 + list.length) % list.length]);
      }
    };

    const step = (delta: number) => {
      const list = visibleItems();
      if (list.length === 0) return;
      current = (current + delta + list.length) % list.length;
      fill(list[current]);
    };

    items.forEach((item) => {
      item.addEventListener("click", (event) => {
        // Cmd/Ctrl/Shift/orta tik: tarayici bağlantıyı yeni sekmede/pencerede acar.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        current = visibleItems().indexOf(item);
        lastFocus = item;
        fill(item);
        dialog.showModal();
      });
    });

    dialog.addEventListener("close", () => {
      history.replaceState(null, "", "/galeri" + location.search);
      if (lastFocus) lastFocus.focus();
    });

    const linked = location.hash.startsWith("#kare-") ? document.getElementById(location.hash.slice(1)) : null;
    if (linked instanceof HTMLAnchorElement && linked.matches("[data-gallery-item]")) linked.click();
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    // Belge duzeyinde: derin baglantiyla acilista odak body'de kalabiliyor.
    document.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (event.key === "ArrowRight") { event.preventDefault(); step(1); }
      if (event.key === "ArrowLeft") { event.preventDefault(); step(-1); }
    });
    // Dokunmatik: yatay kaydirma ile onceki/sonraki kare.
    let touchX = 0;
    let touchY = 0;
    dialog.addEventListener("touchstart", (event) => {
      touchX = event.changedTouches[0].clientX;
      touchY = event.changedTouches[0].clientY;
    }, { passive: true });
    dialog.addEventListener("touchend", (event) => {
      const dx = event.changedTouches[0].clientX - touchX;
      const dy = event.changedTouches[0].clientY - touchY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
    }, { passive: true });
    // Paylas: adres cubugu zaten karenin sayfasi (/galeri/<id>).
    const shareButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-share]");
    shareButton?.addEventListener("click", async () => {
      const result = await shareOrCopy(location.origin + location.pathname, title?.textContent || document.title);
      if (result === "copied") flashLabel(shareButton, "Bağlantı kopyalandı");
      if (result === "failed") flashLabel(shareButton, "Kopyalanamadı");
    });
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => step(-1));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => step(1));
  }
</script>

<style>
  .gallery-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.75rem; }
  .gallery-filters button {
    font: inherit; font-size: 0.8rem; cursor: pointer; padding: 0.4rem 0.9rem;
    color: var(--color-muted); background: transparent;
    border: 1px solid var(--color-border); border-radius: 999px;
  }
  .gallery-filter-count { margin-left: 0.2rem; opacity: 0.6; font-variant-numeric: tabular-nums; }
  .gallery-filters button[aria-pressed="true"] { color: light-dark(#1d2128, #fff); border-color: var(--glass-border-active); font-weight: 600; }
  /* Yaslanmış satırlar: her kare bilinen oranıyla büyür, satırlar kenardan kenara dolar, soldan sağa sıra korunur
     (sütun düzeni sağ altta ~380px boşluk bırakıyordu). Telefonda tek sütun. */
  .gallery-grid { --row: 250px; display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: 1rem; }
  .gallery-item {
    position: relative; display: block; flex: var(--ar, 1.5) 1 calc(var(--ar, 1.5) * var(--row)); max-width: calc(var(--ar, 1.5) * 460px);
    margin: 0; padding: 0; border: 0; cursor: zoom-in; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-bg-subtle);
  }
  @media (max-width: 1000px) { .gallery-grid { --row: 190px; } }
  @media (max-width: 640px) { .gallery-grid { display: grid; grid-template-columns: minmax(0, 1fr); } .gallery-item { max-width: none; } }
  .gallery-item[hidden] { display: none; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .gallery-item:hover img { transform: scale(1.03); }
  .gallery-item-caption {
    position: absolute; inset: auto 0 0 0; padding: 1.4rem 0.9rem 0.75rem;
    font-size: 0.8rem; text-align: left; color: #fff;
    background: linear-gradient(to top, rgba(0,0,0,0.62), transparent);
    opacity: 0; transition: opacity 0.25s ease;
  }
  .gallery-item:hover .gallery-item-caption, .gallery-item:focus-visible .gallery-item-caption { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .gallery-item img { transition: none; } }

  /* Işık kutusu: tam ekran sahne. Görsel kendi oranıyla ekrana sığar (siyah bant yok); oklar fotoğrafın ortasında;
     arka plan neredeyse opak. Yatay karede bilgi altta (fotoğraf genişliğinde), geniş ekranda dikey karede sağ yanda;
     dikey karede "Paylaş" eskiden ekranın altına taşıyordu. */
  .lightbox {
    --lb-chrome: 19rem; box-sizing: border-box; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0;
    padding: 3.5rem 1.25rem 1.25rem; border: 0; background: transparent; overflow: auto; overscroll-behavior: contain;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(8 10 13 / 94%); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .lightbox figure { margin: 0; width: fit-content; display: grid; gap: 1rem; }
  .lightbox-stage { position: relative; }
  .lightbox img {
    display: block; box-sizing: border-box; width: min(100vw - 2.5rem, 1200px, calc((100dvh - var(--lb-chrome)) * var(--ar)));
    height: auto; aspect-ratio: var(--ar); object-fit: cover; border-radius: 12px; background: rgb(255 255 255 / 4%);
  }
  /* Oranı bilinmeyen kare: kırpılmadan sığar. */
  .lightbox:not([data-orient]) img { width: auto; max-width: min(100vw - 2.5rem, 1200px); max-height: calc(100dvh - var(--lb-chrome)); aspect-ratio: auto; object-fit: contain; }
  .lightbox figcaption { width: 0; min-width: 100%; display: grid; align-content: start; gap: 0.3rem; color: #e6e9ec; }
  .lightbox figcaption strong { font-size: 1.2rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; text-wrap: balance; }
  .lightbox figcaption span { font-size: 0.82rem; color: #a3afb9; }
  .lightbox figcaption p { margin: 0.4rem 0 0; font-size: 0.95rem; line-height: 1.65; color: #cfd6dc; max-width: 68ch; text-wrap: pretty; }
  .lightbox .lightbox-count { position: fixed; top: 1.15rem; left: 1.25rem; font-size: 0.8rem; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
  .lightbox .lightbox-count:empty { display: none; }
  .lightbox-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 0.6rem; }
  .lightbox-post { font-size: 0.9rem; color: #e6e9ec; text-underline-offset: 3px; }
  .lightbox-post:hover { color: #fff; }
  .lightbox-post[hidden] { display: none; }
  .lightbox-share {
    padding: 0.45rem 0.95rem; font-size: 0.85rem; cursor: pointer; color: #e6e9ec;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.22); border-radius: 999px;
  }
  .lightbox-share:hover { background: rgba(255,255,255,0.16); color: #fff; }
  .lightbox-share:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .lightbox-close {
    position: fixed; top: 0.6rem; right: 0.6rem; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    font-size: 1.6rem; line-height: 1; color: #fff; border: 0; border-radius: 50%; cursor: pointer;
  }
  .lightbox-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; display: grid; place-items: center; width: 44px; height: 44px;
    padding: 0; font-size: 1.9rem; line-height: 1; color: #fff; border: 0; border-radius: 50%; cursor: pointer;
    background: rgb(10 12 15 / 46%); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .lightbox-prev { left: 0.6rem; }
  .lightbox-next { right: 0.6rem; }
  .lightbox-nav:focus-visible, .lightbox-close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (min-width: 900px) {
    .lightbox[data-orient="portrait"] { --lb-chrome: 5.5rem; }
    .lightbox[data-orient="portrait"] figure { grid-template-columns: auto minmax(240px, 320px); align-items: end; column-gap: 2rem; }
    .lightbox[data-orient="portrait"] figcaption { width: auto; min-width: 0; padding-bottom: 0.25rem; }
  }
  @media (max-width: 600px) {
    .lightbox { --lb-chrome: 21rem; padding: 3.5rem 0.9rem 0.9rem; }
    .lightbox img { width: min(100vw - 1.8rem, calc((100dvh - var(--lb-chrome)) * var(--ar))); }
  }
  @media (prefers-reduced-transparency: reduce) { .lightbox::backdrop, .lightbox-nav { -webkit-backdrop-filter: none; backdrop-filter: none; } }
</style>
