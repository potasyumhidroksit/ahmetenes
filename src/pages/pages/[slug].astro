---
import { notFound } from "../../utils/http";
import { decodeSlug } from "emdash";
import { localizedEntry as getEmDashEntry } from "../../utils/localized-content";
import { PortableText } from "emdash/ui";
import { getEditMeta, type PortableTextBlock } from "emdash";
import Base from "../../layouts/Content.astro";
import { firstParagraphPreview } from "../../utils/first-paragraph";
import PageHero from "../../components/PageHero.astro";
import { PAGE_HEROES, pageHeroOg } from "../../lib/page-hero";

import { localeFromUrl, localePath } from "../../utils/i18n";
const locale = localeFromUrl(Astro.url);
const slug = decodeSlug(Astro.params.slug);

if (/^\/(?:tr\/)?pages\//.test(Astro.url.pathname) && slug) {
	return Astro.redirect(`${localePath(`/${encodeURIComponent(slug)}`, locale)}${Astro.url.search}`, 308);
}

if (!slug) {
	return notFound(Astro);
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug, { locale });

if (!page) {
	return notFound(Astro);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Sayfa basligi zaten <h1>; icerikteki h1 bloklari h2'ye indirilir, basligi
// tekrar eden ilk h1 atlanir (tek h1, tekrar eden baslik yok).
// Duzenleme modunda (gorsel editor) icerige dokunma.
const blockText = (block: PortableTextBlock) =>
	((block as { children?: Array<{ text?: string }> }).children ?? []).map((child) => child.text ?? "").join("").trim();
const rawContent = page.data.content as PortableTextBlock[] | undefined;
const content = Array.isArray(rawContent) && !getEditMeta(rawContent)
	? rawContent
		.filter((block, index) => !(index === 0 && block.style === "h1" && blockText(block).toLocaleLowerCase("tr") === page.data.title.toLocaleLowerCase("tr")))
		.map((block) => (block.style === "h1" ? { ...block, style: "h2" } : block))
	: rawContent;
// Ilk paragraf kisa kalirsa (ör. /now) ara basliklarla zenginlestir.
const headings = (Array.isArray(rawContent) ? rawContent : [])
	.filter((block) => block.style === "h2")
	.map((block) => blockText(block))
	.filter(Boolean);
const lead = firstParagraphPreview(rawContent);
const description = (lead.length < 70 && headings.length
	? `${lead.replace(/[.:]$/, "")}: ${headings.join(", ")}.`
	: lead) || undefined;
// Hakkimda: Google ProfilePage (yaratici profili); galeri/yazi JSON-LD'si ile
// ayni kisiye baglanir.
const origin = Astro.url.origin;
const profileJsonLd = slug === "hakkimda"
	? {
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			url: origin + "/hakkimda",
			dateModified: page.data.updatedAt?.toISOString(),
			mainEntity: {
				"@type": "Person",
				"@id": origin + "/#person",
				name: "Ahmet Enes",
				jobTitle: "Fotoğrafçı",
				url: origin,
				image: origin + "/avatar.webp",
				description,
				email: "mailto:info@ahmetenes.com",
				sameAs: ["https://instagram.com/eneswideshut"],
			},
		}
	: undefined;
const updated = slug === "now" && page.data.updatedAt
	? page.data.updatedAt.toLocaleDateString("tr-TR", { year: "numeric", month: "long", day: "numeric" })
	: null;
---

<Base
	title={page.data.title}
	description={description}
	image={slug === "hakkimda" ? undefined : pageHeroOg(slug, origin)}
	imageAlt={slug === "hakkimda" ? undefined : PAGE_HEROES[slug]?.alt}
	jsonLd={profileJsonLd}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page-article">
		{PAGE_HEROES[slug] && <PageHero {...PAGE_HEROES[slug]} />}
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
			{updated && <p class="page-updated">Son güncelleme: <time datetime={page.data.updatedAt.toISOString()}>{updated}</time></p>}
		</header>

		<div class="page-content">
			<PortableText value={content} />
		</div>

		{slug === "hakkimda" && (
			<ul class="page-links" aria-label="Bağlantılar">
				<li><a href="mailto:info@ahmetenes.com">info@ahmetenes.com</a></li>
				<li><a href="https://instagram.com/eneswideshut" target="_blank" rel="noopener noreferrer">Instagram · @eneswideshut</a></li>
				<li><a href={localePath("/iletisim", locale)}>İletişim formu →</a></li>
			</ul>
		)}
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-updated {
		margin-top: var(--spacing-3, 0.75rem);
		font-size: var(--font-size-sm, 0.875rem);
		color: var(--color-muted);
	}

	.page-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: var(--spacing-6, 1.5rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.page-links a {
		display: inline-block;
		padding: 0.6rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		text-decoration: none;
	}

	.page-links a:hover {
		border-color: var(--color-text-secondary);
	}

	.page-links a:focus-visible {
		outline: 2px solid light-dark(#536163, #e0e6eb);
		outline-offset: 3px;
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: var(--spacing-6);
		border-left: 3px solid var(--color-border);
		color: var(--color-muted);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
