---
import { notFound } from "../../utils/http";
import {
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getCommentCount,
	getEditMeta,
} from "emdash";
import { PortableText } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Content.astro";
import PostCard from "../../components/PostCard.astro";
import PostShare from "../../components/PostShare.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { galleryHref, galleryPhotoFor } from "../../lib/blog-photo";
import { exifLine } from "../../lib/gallery";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import BlogImage from "../../components/BlogImage.astro";
import { imageSrc, ogImage } from "../../lib/responsive-image";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

import { localizedEntry as getEmDashEntry } from "../../utils/localized-content";
import { localizedPosts } from "../../utils/localized-posts";
import { commentCountLabel, localeFromUrl, localePath, readingTimeLabel, translate } from "../../utils/i18n";
import { localizeTurkish } from "../../utils/turkish-content";
const locale = localeFromUrl(Astro.url);
const t = (text: string) => translate(locale, text);

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return notFound(Astro);
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, { locale });

if (!post) {
	return notFound(Astro);
}

// Kanonik yazı URL'i köktedir; /posts/<slug> isteğini tek adımda oraya taşı.
if (/^\/(?:tr\/)?posts\//.test(Astro.url.pathname)) {
	return Astro.redirect(`${localePath(`/${encodeURIComponent(slug)}`, locale)}${Astro.url.search}`, 308);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || (typeof img !== "object" && typeof img !== "string")) return undefined;
	if (typeof img === "string") {
		if (!img) return undefined;
		return img.startsWith("http") ? img : `${Astro.url.origin}${img}`;
	}
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
// Paylasim: kapagin 1200x630 JPEG surumu varsa o (WebP her platformda gorunmuyor).
const featuredImageUrl = getImageUrl(ogImage(post.data.featured_image) ?? post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const localizedSiteTitle = locale === "tr" ? localizeTurkish(siteTitle) : t(siteTitle);

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle: localizedSiteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
const commentCount = await getCommentCount("posts", post.data.id);

// Kapak galerideki bir kareyse altinda cekim bilgisi + galeride ac.
const heroPhoto = await galleryPhotoFor(post.data.featured_image);

// Kapak gorseli zaten hero'da; govdede ayni kareyi ikinci kez gosterme.
// Duzenleme modunda (gorsel editor) icerige dokunma.
const heroSrc = imageSrc(post.data.featured_image);
const bodyContent = heroSrc && Array.isArray(post.data.content) && !getEditMeta(post.data.content)
	? post.data.content.filter((block) => !(block._type === "image" && (block as { asset?: { url?: string } }).asset?.url === heroSrc))
	: post.data.content;

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.


// Fetch a few extra recent posts in case the current post is among them.
const { entries: recentPosts, cacheHint: recentHint } = await localizedPosts(locale, {
	orderBy: { published_at: "desc" },
	limit: 4,
});
if (Astro.cache?.enabled) Astro.cache.set(recentHint);
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: otherTagsByEntry.get(p.data.id) ?? [],
	bylines: p.data.bylines ?? [],
}));

const publishDate =
	post.data.publishedAt?.toLocaleDateString(locale === "tr" ? "tr-TR" : "en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={bylines[0]?.byline.displayName || "Ahmet Enes"}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
	<article class="article">
		{/* Hero: Full-width featured image */}
		{
			post.data.featured_image && (
				<div class="article-hero" {...post.edit.featured_image}>
					<ResponsiveImage image={post.data.featured_image} sizes="(max-width: 736px) calc(100vw - 76px), min(1160px, calc(100vw - 128px))" priority />
				</div>
			)
		}
		{
			heroPhoto && (
				<p class="article-hero-caption">
					<span>{heroPhoto.title}{exifLine(heroPhoto) && <> · {exifLine(heroPhoto)}</>}</span>
					<a href={galleryHref(heroPhoto)}>Galeride aç →</a>
				</p>
			)
		}

		{/* Centered reading column */}
		<div class="article-grid">
			{/* Main content */}
			<div class="article-main">
				<header class="article-header">
					<div class="article-meta">
						{
							bylines.length > 0 && (
								<>
									<span class="article-meta-byline">
										{bylines.map((credit, i) => (
											<>
												{i > 0 && ", "}
												{credit.byline.displayName}
											</>
										))}
									</span>
									<span class="meta-dot" />
								</>
							)
						}
						{
							publishDate && (
								<>
									<time>{publishDate}</time>
									<span class="meta-dot" />
								</>
							)
						}
						<span>{readingTimeLabel(locale, readingTime)}</span>
					</div>
					<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
					{
						post.data.excerpt && (
							<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
						)
					}
				</header>

				<div class="article-content">
					<PortableText value={bodyContent} components={{ type: { image: BlogImage } }} />
				</div>

				<PostShare title={post.data.title} url={new URL(Astro.url.pathname, Astro.url.origin).href} locale={locale} />

				<footer class="article-taxonomy" aria-label={locale === "tr" ? "Yazı bilgileri" : "Post information"}>
					{categories.length > 0 && <div class="taxonomy-item">
						<span class="taxonomy-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 6.5h6l2 2h9v10h-17z"/><path d="M3.5 8.5v-3h6l2 3"/></svg></span>
						<div class="taxonomy-values">{categories.map((term) => <a href={localePath(`/category/${term.slug}`, locale)} aria-label={`${t("Kategori")}: ${term.label}`}>{term.label}</a>)}</div>
					</div>}
					{tags.length > 0 && <div class="taxonomy-item">
						<span class="taxonomy-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 13 13 20l-9-9V4h7z"/><circle cx="8.5" cy="8.5" r="1.2"/></svg></span>
						<div class="taxonomy-values">{tags.map((term) => <a href={localePath(`/tag/${term.slug}`, locale)} aria-label={`${t("Etiket")}: ${term.label}`}>{term.label}</a>)}</div>
					</div>}
					{commentCount > 0 && <a href="#comments" class="taxonomy-item taxonomy-comments">
						<span class="taxonomy-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14v11H9l-4 3z"/></svg></span>
						<span class="taxonomy-value">{commentCountLabel(locale, commentCount)}</span>
					</a>}
				</footer>
				<NewsletterForm
					variant="card"
					heading="Yeni yazılardan haberdar ol"
					text="Işık, kompozisyon, sokak ve ekipman üzerine yeni notlar e-postana gelsin. Onay e-postasıyla kayıt; istediğin an çıkabilirsin."
				/>
				<div class="article-comments" id="comments" data-comment-locale={locale} data-comment-count={commentCount}>
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>


		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="more-title">{t("İlgini Çekebilir")}</h2>
					<div class="more-grid">
						{otherPostsWithTags.map(
							({ post: p, tags: postTags, bylines: postBylines }) => (
								<PostCard
									title={p.data.title}
									excerpt={p.data.excerpt}
									featuredImage={p.data.featured_image}
									href={`/${p.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									tags={postTags.map((t) => ({ slug: t.slug, label: locale === "tr" ? localizeTurkish(t.label) : t.label }))}
									bylines={postBylines}
								/>
							)
						)}
					</div>
				</div>
			</section>
		)
	}


</Base>

<script>
  const comments = document.querySelector<HTMLElement>(".article-comments");
  const isTurkish = comments?.dataset.commentLocale === "tr";
  const commentText: Record<string, string> = {
    Name: "Adınız",
    Email: "E-posta adresiniz",
    Comment: "Yorumunuz",
    "Post Comment": "Yorumu Gönder",
    "Submitting...": "Gönderiliyor...",
    "Comment submitted!": "Yorumunuz gönderildi!",
    "Failed to submit comment.": "Yorum gönderilemedi.",
    "Network error. Please try again.": "Ağ hatası. Lütfen tekrar deneyin.",
  };
  const tr = (value: string) => isTurkish ? commentText[value] ?? value : value;
  document.querySelectorAll<HTMLLabelElement>(".article-comments .ec-comment-form-field").forEach((label) => {
    const caption = label.querySelector("span");
    const field = label.querySelector<HTMLInputElement | HTMLTextAreaElement>("input, textarea");
    if (!caption || !field) return;
    const translatedCaption = tr(caption.textContent?.trim() ?? "");
    caption.textContent = translatedCaption;
    field.placeholder = translatedCaption;
    label.classList.add("has-placeholder-label");
  });
  if (comments) {
    const count = Number(comments.dataset.commentCount ?? 0);
    const heading = comments.querySelector<HTMLElement>(".ec-comments-heading");
    if (heading && isTurkish) heading.textContent = count === 0 ? "Henüz yorum yok" : `${count} yorum`;
    comments.querySelectorAll<HTMLElement>(".ec-comment-form-submit, .ec-comment-form-status").forEach((element) => {
      const localizeElement = () => {
        const value = element.textContent?.trim() ?? "";
        const translated = tr(value);
        if (translated !== value) element.textContent = translated;
      };
      localizeElement();
      new MutationObserver(localizeElement).observe(element, { childList: true, characterData: true, subtree: true });
    });
  }
  const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
  if (bar) {
    let scheduled = false;
    const update = () => {
      const range = document.documentElement.scrollHeight - window.innerHeight;
      const progress = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
      bar.style.transform = `scaleX(${progress})`;
      scheduled = false;
    };
    const schedule = () => {
      if (!scheduled) { scheduled = true; requestAnimationFrame(update); }
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    new ResizeObserver(schedule).observe(document.body);
    update();
  }
</script>

<style>
  .reading-progress { position: fixed; inset: 0 0 auto; height: 4px; z-index: 1000; pointer-events: none; }
  .reading-progress span { display: block; width: 100%; height: 100%; background: var(--color-brand, #0066cc); transform: scaleX(0); transform-origin: left; }
  .article-taxonomy { margin-top: 32px; padding-block: 20px; border-block: 1px solid var(--glass-border-active); display: flex; flex-wrap: wrap; align-items: center; gap: 20px 36px; }
  .taxonomy-item { min-width: 0; max-width: 100%; min-height: 44px; display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
  .taxonomy-icon { display: grid; place-items: center; flex: 0 0 20px; width: 20px; height: 24px; color: light-dark(#536163, #cbd5dc); }
  .taxonomy-icon svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .taxonomy-values { display: flex; flex-wrap: wrap; gap: 3px 8px; }
  .taxonomy-values a, .taxonomy-value { color: var(--color-text); font-size: 14px; line-height: 1.4; overflow-wrap: anywhere; }
  .taxonomy-values a { display: inline-flex; align-items: center; min-height: 28px; text-underline-offset: 3px; }
  .taxonomy-values a:hover { text-decoration: underline; }
  .taxonomy-comments { margin-left: auto; }
  .taxonomy-comments:hover .taxonomy-value { text-decoration: underline; text-underline-offset: 3px; }
  .taxonomy-comments:focus-visible { outline: 2px solid light-dark(#536163, #ccd7df); outline-offset: 3px; }
  @media (max-width: 600px) {
    .article-taxonomy { gap: 16px 24px; }
    .taxonomy-comments { margin-left: 0; }
  }
  #comments { scroll-margin-top: 24px; }
	/* Article container */
	.article {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	/* Hero image - full width within container */
	.article-hero {
		margin: var(--spacing-16) var(--spacing-6);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
	}

	/* Hero'nun hemen altinda; bosluklar theme.css'te .article-hero ile birlikte. */
	.article-hero-caption {
		display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem;
		font-size: 0.8125rem; color: var(--color-muted); font-variant-numeric: tabular-nums;
	}
	.article-hero-caption a { color: var(--color-text-secondary); text-decoration: none; white-space: nowrap; }
	.article-hero-caption a:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 3px; }

	.article-hero img {
		width: 100%;
		height: auto;
		max-height: 500px;
		object-fit: cover;
	}

	/* Three-column grid */
	.article-grid {
		display: grid;
		grid-template-columns:
			var(--meta-col-width) minmax(0, var(--content-width))
			var(--gutter-width);
		gap: var(--spacing-10);
		justify-content: center;
		padding: 0 var(--spacing-6);
		margin: var(--spacing-16) 0;
	}

	/* Byline styles */
	.bylines {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	/* Main content column */
	.article-main {
		min-width: 0;
	}

	.article-header {
		margin-bottom: var(--spacing-10);
	}

	.article-header .article-meta {
		display: none;
		align-items: center;
		flex-wrap: wrap;
		column-gap: var(--spacing-3);
		row-gap: var(--spacing-1);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-4);
	}

	.article-meta-byline {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.article-title {
		font-size: clamp(2rem, 5vw, var(--font-size-5xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-4);
	}

	.article-excerpt {
		font-size: var(--font-size-xl);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* Article content typography */
	.article-content {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
	}

	.article-content :global(p) {
		margin-bottom: 1.5em;
	}

	.article-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2.5em;
		margin-bottom: 0.75em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.article-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 2em;
		margin-bottom: 0.5em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.article-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-border);
		background: var(--color-bg-subtle);
		border-radius: 0 var(--radius) var(--radius) 0;
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.article-content :global(pre) {
		margin: 2em 0;
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.article-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
	}

	.article-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.article-content :global(li) {
		margin-bottom: 0.5em;
	}

	.article-content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius-lg);
	}

	.article-content :global(hr) {
		margin: 3em 0;
		border: none;
		border-top: 1px solid var(--color-border);
	}

	.article-content :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.article-content :global(a:hover) {
		text-decoration-thickness: 2px;
	}

	/* Comments section */
	.article-comments {
		margin-top: 0;
		padding-top: var(--spacing-10);
	}

	/* Yorumlar kapaliyken bolum yalnizca bir <script> icerir; bos 40px birakmasin. */
	.article-comments:not(:has(> :not(script))) {
		display: none;
	}

	.article-comments :global(.ec-comments) {
		--ec-comment-border: 1px solid var(--color-border);
	}

	.article-comments :global(.ec-comments-heading) {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-8);
	}

	.article-comments :global(.ec-comment-author) {
		color: var(--color-text);
	}

	.article-comments :global(.ec-comment-date) {
		font-family: var(--font-mono);
		color: var(--color-muted);
	}

	.article-comments :global(.ec-comment-body) {
		color: var(--color-text);
	}

	/* More posts section */
	.more-posts {
		background: var(--color-bg-subtle);
		padding: var(--spacing-16) 0;
		margin-top: var(--spacing-16);
	}

	.more-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-6);
	}

	.more-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-10);
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
	}

	/* Responsive */
	@media (max-width: 1100px) {
		.article-grid {
			grid-template-columns: minmax(0, var(--content-width));
			gap: 0;
		}

		.article-header .article-meta {
			display: flex;
		}
	}

	@media (max-width: 900px) {
		.article-hero {
			margin: var(--spacing-4) var(--spacing-4) var(--spacing-8);
			border-radius: var(--radius);
		}

		.article-grid {
			padding: 0 var(--spacing-4);
		}

		.more-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.article-title {
			font-size: var(--font-size-3xl);
		}

		.more-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
