---
import { notFound } from "../../utils/http";
import {
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getCommentCount,
	getEditMeta,
} from "emdash";
import { PortableText } from "emdash/ui";
import { extractFootnotes } from "../../lib/footnotes";
import ogPosts from "../../data/og-posts.json";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Content.astro";
import PostCard from "../../components/PostCard.astro";
import PostShare from "../../components/PostShare.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { galleryHref, galleryPhotoFor } from "../../lib/blog-photo";
import { exifLine } from "../../lib/gallery";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import BlogImage from "../../components/BlogImage.astro";
import ArticleBlock from "../../components/ArticleBlock.astro";
import ArticleTaxonomy from "../../components/ArticleTaxonomy.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import ReadingNav from "../../components/ReadingNav.astro";
import { blockText, headingId } from "../../lib/heading-id";
import ImageCredit from "../../components/ImageCredit.astro";
import { imageCredit } from "../../lib/image-credit";
import { absoluteImageUrl, imageSrc, ogImage } from "../../lib/responsive-image";
import { getReadingTime } from "../../utils/reading-time";
import { readingNeighbors } from "../../utils/reading-order";
import { relatedPosts } from "../../utils/related-posts";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

import { localizedEntry as getEmDashEntry } from "../../utils/localized-content";
import { localizedPosts } from "../../utils/localized-posts";
import { formatDate, localeFromUrl, localePath, readingTimeLabel, translate } from "../../utils/i18n";
import { localizeTurkish } from "../../utils/turkish-content";
const locale = localeFromUrl(Astro.url);
const t = (text: string) => translate(locale, text);

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return notFound(Astro);
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, { locale });

if (!post) {
	return notFound(Astro);
}

// Kanonik yazı URL'i köktedir; /posts/<slug> isteğini tek adımda oraya taşı.
if (/^\/(?:tr\/)?posts\//.test(Astro.url.pathname)) {
	return Astro.redirect(`${localePath(`/${encodeURIComponent(slug)}`, locale)}${Astro.url.search}`, 308);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Paylasim: kapagin 1200x630 JPEG surumu varsa o (WebP her platformda gorunmuyor).
// Kapaksiz yazi: fotografsiz tipografik paylasim gorseli (scripts/og-yazilar.mjs).
const featuredImageUrl =
	absoluteImageUrl(ogImage(post.data.featured_image) ?? post.data.featured_image, Astro.url.origin) ??
	((ogPosts as string[]).includes(slug) ? `${Astro.url.origin}/og/${slug}.jpg` : undefined);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const localizedSiteTitle = locale === "tr" ? localizeTurkish(siteTitle) : t(siteTitle);

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle: localizedSiteTitle,
	// Diger sayfalarla ayni ayirici ("X — Ahmet Enes"; varsayilan " | ").
	titleSeparator: " — ",
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

// Arama sonucunda ~60 karakterden sonrasi kesilir: uzun basliklarda site eki dusulur.
const documentTitle = seo.title.length > 60 ? (post.data.title || seo.title) : seo.title;

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
const commentCount = await getCommentCount("posts", post.data.id);

// Kapak galerideki bir kareyse altinda cekim bilgisi + galeride ac.
const heroPhoto = await galleryPhotoFor(post.data.featured_image);

// Kapak gorseli zaten hero'da; govdede ayni kareyi ikinci kez gosterme.
// Duzenleme modunda (gorsel editor) icerige dokunma.
const heroSrc = imageSrc(post.data.featured_image);
const bodyContent = heroSrc && Array.isArray(post.data.content) && !getEditMeta(post.data.content)
	? post.data.content.filter((block) => !(block._type === "image" && (block as { asset?: { url?: string } }).asset?.url === heroSrc))
	: post.data.content;
// Dipnotlar: [^n] -> ust simge baglanti, "[^n]: ..." paragraflari sonda liste.
const { body: articleBody, notes: footnotes } = getEditMeta(post.data.content)
	? { body: bodyContent, notes: [] }
	: extractFootnotes(bodyContent);

// "Bu yazida": 4+ ara baslikli yazida acilir icindekiler (kimlikler
// ArticleBlock'ta ayni fonksiyonla verilir). Tekrarlanan baslik varsa gosterme.
const toc = getEditMeta(post.data.content) || !Array.isArray(articleBody)
	? []
	: (articleBody as Array<{ _type?: string; style?: string; children?: unknown }>)
		.filter((block) => block?._type === "block" && block.style === "h2" && blockText(block.children).trim())
		.map((block) => ({ id: headingId(block.children), text: blockText(block.children).trim() }));
const showToc = toc.length >= 4 && new Set(toc.map((item) => item.id)).size === toc.length;

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed. Son 50 yazi: okuma sirasi ve "Ilgini cekebilir".
const { entries: recentPosts, cacheHint: recentHint } = await localizedPosts(locale, {
	orderBy: { published_at: "desc" },
	limit: 50,
});
if (Astro.cache?.enabled) Astro.cache.set(recentHint);
// Okuma sirasinda onceki/sonraki yazi (yeni baslayan icin rehberli ilerleyis).
const reading = readingNeighbors(recentPosts, post.id);
const otherPosts = relatedPosts(recentPosts, post);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: otherTagsByEntry.get(p.data.id) ?? [],
	bylines: p.data.bylines ?? [],
}));

const publishDate = post.data.publishedAt ? formatDate(post.data.publishedAt, locale) : null;
---

<Base
	title={documentTitle}
	exactTitle
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={bylines[0]?.byline.displayName || "Ahmet Enes"}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
	<article class="article">
		{/* Hero: Full-width featured image */}
		{
			post.data.featured_image && (
				<div class="article-hero" {...post.edit.featured_image}>
					<ResponsiveImage image={post.data.featured_image} sizes="(max-width: 736px) calc(100vw - 76px), min(1160px, calc(100vw - 128px))" priority />
				</div>
			)
		}
		{
			heroPhoto ? (
				<p class="article-hero-caption">
					<span>{heroPhoto.title}{exifLine(heroPhoto) && <> · {exifLine(heroPhoto)}</>}</span>
					<a href={galleryHref(heroPhoto)}>Galeride aç →</a>
				</p>
			) : post.data.featured_image && imageCredit(post.data.featured_image) && (
				<p class="article-hero-caption">
					<ImageCredit image={post.data.featured_image} />
				</p>
			)
		}

		{/* Centered reading column */}
		<div class="article-grid">
			{/* Main content */}
			<div class="article-main">
				<header class="article-header">
					<div class="article-meta">
						{
							bylines.length > 0 && (
								<>
									<span class="article-meta-byline">
										{bylines.map((credit, i) => (
											<>
												{i > 0 && ", "}
												{credit.byline.displayName}
											</>
										))}
									</span>
									<span class="meta-dot" />
								</>
							)
						}
						{
							publishDate && (
								<>
									<time>{publishDate}</time>
									<span class="meta-dot" />
								</>
							)
						}
						<span>{readingTimeLabel(locale, readingTime)}</span>
					</div>
					<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
					{
						post.data.excerpt && (
							<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
						)
					}
				</header>

				{showToc && <ArticleToc toc={toc} />}

				<div class="article-content">
					<PortableText value={articleBody} components={{ block: ArticleBlock, type: { image: BlogImage } }} />
					{footnotes.length > 0 && (
						<section class="footnotes" aria-labelledby="dipnotlar">
							<h2 id="dipnotlar">Dipnotlar</h2>
							<ol>
								{footnotes.map((note) => (
									<li id={"dipnot-" + note.n} value={note.n}>
										<PortableText value={[note.block]} />
									</li>
								))}
							</ol>
						</section>
					)}
				</div>

				{showToc && <p class="article-top"><a href="#top"><span aria-hidden="true">↑</span>&nbsp;{t("Başa dön")}</a></p>}

				{reading && (reading.prev || reading.next) && <ReadingNav reading={reading} />}

				<PostShare title={post.data.title} url={new URL(Astro.url.pathname, Astro.url.origin).href} locale={locale} />

				<ArticleTaxonomy categories={categories} tags={tags} commentCount={commentCount} />
				<NewsletterForm
					variant="card"
					heading="Yeni yazılardan haberdar ol"
					text="Işık, kompozisyon, sokak ve ekipman üzerine yeni notlar e-postana gelsin. Onay e-postasıyla kayıt; istediğin an çıkabilirsin."
				/>
				<div class="article-comments" id="comments" data-comment-locale={locale} data-comment-count={commentCount}>
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>


		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="more-title">{t("İlgini çekebilir")}</h2>
					<div class="more-grid">
						{otherPostsWithTags.map(
							({ post: p, tags: postTags, bylines: postBylines }) => (
								<PostCard
									title={p.data.title}
									excerpt={p.data.excerpt}
									featuredImage={p.data.featured_image}
									href={`/${p.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									tags={postTags.map((t) => ({ slug: t.slug, label: locale === "tr" ? localizeTurkish(t.label) : t.label }))}
									bylines={postBylines}
								/>
							)
						)}
					</div>
				</div>
			</section>
		)
	}


</Base>

<script>
  import "../../scripts/comment-localization";
  import "../../scripts/reading-progress";
</script>

<style>
  .reading-progress { position: fixed; inset: 0 0 auto; height: 4px; z-index: 1000; pointer-events: none; }
  .reading-progress span { display: block; width: 100%; height: 100%; background: var(--color-brand, #0066cc); transform: scaleX(0); transform-origin: left; }
  #comments { scroll-margin-top: 24px; }
  .article-content :global(h2[id]) { scroll-margin-top: 24px; }
  .article-top { margin: 32px 0 0; font-size: 0.875rem; }
  .article-top a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-text-secondary); text-decoration: none; }
  .article-top a:hover { color: var(--color-text); }
  @media print { .article-top { display: none; } }

	/* Article container */
	.article {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	/* Hero image - full width within container */
	.article-hero {
		margin: var(--spacing-16) var(--spacing-6);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
	}

	/* Hero'nun hemen altinda; bosluklar theme.css'te .article-hero ile birlikte. */
	.article-hero-caption {
		display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem;
		font-size: 0.8125rem; color: var(--color-muted); font-variant-numeric: tabular-nums;
	}
	.article-hero-caption a { color: var(--color-text-secondary); text-decoration: none; white-space: nowrap; }
	.article-hero-caption a:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 3px; }

	.article-hero img {
		width: 100%;
		height: auto;
		max-height: 500px;
		object-fit: cover;
	}

	/* Three-column grid */
	.article-grid {
		display: grid;
		grid-template-columns:
			var(--meta-col-width) minmax(0, var(--content-width))
			var(--gutter-width);
		gap: var(--spacing-10);
		justify-content: center;
		padding: 0 var(--spacing-6);
		margin: var(--spacing-16) 0;
	}

	/* Byline styles */
	.bylines {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	/* Main content column */
	.article-main {
		min-width: 0;
	}

	.article-header {
		margin-bottom: var(--spacing-10);
	}

	.article-header .article-meta {
		display: none;
		align-items: center;
		flex-wrap: wrap;
		column-gap: var(--spacing-3);
		row-gap: var(--spacing-1);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-4);
	}

	.article-meta-byline {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.article-title {
		font-size: clamp(2rem, 5vw, var(--font-size-5xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-4);
	}

	.article-excerpt {
		font-size: var(--font-size-xl);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* Article content typography */
	.article-content :global(a[href^="#dipnot-"]) {
		font-size: 0.72em; vertical-align: super; line-height: 0; padding: 0 0.1em; text-decoration: none;
	}
	.footnotes { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border-subtle); font-size: 0.9rem; color: var(--color-muted); }
	.footnotes h2 { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 0.75rem; }
	.footnotes ol { margin: 0; padding-left: 1.4em; }
	.footnotes li { scroll-margin-top: 1.5rem; }
	.footnotes li :global(p) { margin: 0 0 0.5rem; }
	.footnotes li:target { color: var(--color-text); }

	.article-content {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
	}

	.article-content :global(p) {
		margin-bottom: 1.5em;
	}

	.article-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2.5em;
		margin-bottom: 0.75em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.article-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 2em;
		margin-bottom: 0.5em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.article-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-border);
		background: var(--color-bg-subtle);
		border-radius: 0 var(--radius) var(--radius) 0;
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.article-content :global(pre) {
		margin: 2em 0;
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.article-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
	}

	.article-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.article-content :global(li) {
		margin-bottom: 0.5em;
	}

	.article-content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius-lg);
	}

	.article-content :global(hr) {
		margin: 3em 0;
		border: none;
		border-top: 1px solid var(--color-border);
	}

	.article-content :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.article-content :global(a:hover) {
		text-decoration-thickness: 2px;
	}

	/* Comments section */
	.article-comments {
		margin-top: 0;
		padding-top: var(--spacing-10);
	}

	/* Yorumlar kapaliyken bolum yalnizca bir <script> icerir; bos 40px birakmasin. */
	.article-comments:not(:has(> :not(script))) {
		display: none;
	}

	.article-comments :global(.ec-comments) {
		--ec-comment-border: 1px solid var(--color-border);
	}

	.article-comments :global(.ec-comments-heading) {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-8);
	}

	.article-comments :global(.ec-comment-author) {
		color: var(--color-text);
	}

	.article-comments :global(.ec-comment-date) {
		font-family: var(--font-mono);
		color: var(--color-muted);
	}

	.article-comments :global(.ec-comment-body) {
		color: var(--color-text);
	}

	/* More posts section */
	.more-posts {
		background: var(--color-bg-subtle);
		padding: var(--spacing-16) 0;
		margin-top: var(--spacing-16);
	}

	.more-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-6);
	}

	.more-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-10);
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
	}

	/* Responsive */
	@media (max-width: 1100px) {
		.article-grid {
			grid-template-columns: minmax(0, var(--content-width));
			gap: 0;
		}

		.article-header .article-meta {
			display: flex;
		}
	}

	@media (max-width: 900px) {
		.article-hero {
			margin: var(--spacing-4) var(--spacing-4) var(--spacing-8);
			border-radius: var(--radius);
		}

		.article-grid {
			padding: 0 var(--spacing-4);
		}

		.more-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.article-title {
			font-size: var(--font-size-3xl);
		}

		.more-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
