---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Content.astro";
import { localizedPosts } from "../utils/localized-posts";
import { excerptAround, fold, highlight, plainText, searchTerms } from "../lib/search-text";
import { galleryCategories, loadGallery, type GalleryPhoto } from "../lib/gallery";
import { imageSrc, localImage } from "../lib/responsive-image";

import { localeFromUrl, localePath, translate } from "../utils/i18n";
const locale = localeFromUrl(Astro.url);
const t = (text: string) => translate(locale, text);
const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
type SearchResult = { id: string; slug?: string | null; title?: string | null; snippet?: string | null; image?: string };
let results: SearchResult[] = [];
/** Sonuc kucuk resmi: kapagin 640px varyanti (manifestte varsa). */
const thumbOf = (src?: string) => {
	const local = localImage(src);
	if (!local) return undefined;
	const w = local.width > 640 ? 640 : local.width;
	return { src: w === 640 ? local.src.replace(/\.[^.]+$/, "-640w.webp") : local.src, width: w, height: Math.round((local.height / local.width) * w), color: local.color };
};
const exactTerms = query.slice(0, 100).toLocaleLowerCase("tr-TR").split(/\s+/).filter(Boolean);
/** Sorgu kelimelerinden katlanmadan (Turkce harfleriyle) gecen her biri icin puan. */
const exactBonus = (text: string, weight: number) => {
	const lower = text.toLocaleLowerCase("tr-TR");
	return exactTerms.filter((term) => lower.includes(term)).length * weight;
};
if (query && locale === "tr") {
	// Katlamali (ışık = isik), tum kelimeleri iceren, basligi one alan arama.
	// Yalnizca okunur metin aranir; eskiden _type/_key/gorsel URL'leri de
	// aranip "span", "webp" gibi sorgular tum yazilari donduruyordu.
	const terms = searchTerms(query);
	const { entries } = await localizedPosts("tr", { limit: 100, orderBy: { published_at: "desc" } });
	// Katlama "isik"i "ışık"la eslestirir ama "gece"yi "geçen"le de; sorgunun
	// birebir (katlanmamis) gectigi sonuclar one alinir.
	results = entries
		.map((entry) => {
			const title = entry.data.title ?? "";
			const excerpt = entry.data.excerpt ?? "";
			const body = plainText(entry.data.content);
			const [ft, fe, fb] = [fold(title), fold(excerpt), fold(body)];
			if (!terms.every((term) => ft.includes(term) || fe.includes(term) || fb.includes(term))) return null;
			const score =
				terms.reduce((sum, term) => sum + (ft.includes(term) ? 10 : 0) + (fe.includes(term) ? 3 : 0) + (fb.includes(term) ? 1 : 0), 0) +
				exactBonus(title, 20) + exactBonus(excerpt, 6) + exactBonus(body, 2);
			const inExcerpt = terms.some((term) => fe.includes(term));
			const snippetText = inExcerpt || !excerpt ? excerpt || excerptAround(body, terms) || "" : excerptAround(body, terms) || excerpt;
			return { score, result: { id: entry.data.id, slug: entry.id, title, snippet: highlight(snippetText, terms), image: imageSrc(entry.data.featured_image) } };
		})
		.filter((hit): hit is NonNullable<typeof hit> => hit !== null)
		.sort((a, b) => b.score - a.score)
		.slice(0, 30)
		.map((hit) => hit.result);
} else if (query) {
	results = (await search(query, { collections: ["posts"], limit: 30, locale: "en" })).items;
}

// Galeri kareleri: baslik, hikaye, konum, etiket, kategori ve ekipman.
let photoHits: GalleryPhoto[] = [];
if (query) {
	const terms = searchTerms(query);
	const categoryLabel = new Map(galleryCategories.map((cat) => [cat.id, cat.label]));
	try {
		photoHits = (await loadGallery())
			.map((photo) => {
				const title = fold(photo.title);
				const rest = fold(
					[photo.alt, photo.story, photo.location, photo.year, ...(photo.tags ?? []), categoryLabel.get(photo.category), photo.exif?.camera, photo.exif?.lens]
						.filter(Boolean)
						.join(" "),
				);
				if (terms.length === 0 || !terms.every((term) => title.includes(term) || rest.includes(term))) return null;
				return { photo, score: terms.reduce((sum, term) => sum + (title.includes(term) ? 10 : 1), 0) + exactBonus(photo.title, 20) + exactBonus(photo.story ?? "", 2) };
			})
			.filter((hit): hit is NonNullable<typeof hit> => hit !== null)
			.sort((a, b) => b.score - a.score)
			.slice(0, 12)
			.map((hit) => hit.photo);
	} catch {
		// galeri alinamazsa yalnizca yazilar
	}
}
const thumb = (photo: GalleryPhoto) => (photo.srcSet.find((s) => s.w === 480) ?? photo.srcSet[0])?.src ?? photo.src;
const summary = [results.length && `${results.length} yazı`, photoHits.length && `${photoHits.length} kare`].filter(Boolean).join(", ");
---

<Base
	title={query ? `${t("Ara")}: ${query}` : t("Ara")}
	description={t("Yazılarda ve galeride arayın")}
	robots="noindex, follow"
>
	<section class="search-page">
		<h1 class="search-title">{t("Ara")}</h1>

		<form method="get" action={localePath("/search", locale)} class="search-form">
			<input
				type="search"
				name="q"
                aria-label={t("Yazılarda ve galeride ara")}
				value={query}
				placeholder={t("Yazılarda ve galeride ara...")}
				class="search-input"
			/>
			<button type="submit" class="search-button">{t("Ara")}</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{!summary
						? (locale === "tr" ? `“${query}” için sonuç bulunamadı.` : `No results for “${query}”.`)
						: (locale === "tr" ? `“${query}” için ${summary}` : `${results.length} results for “${query}”`)}
				</p>
			)
		}

		{
			photoHits.length > 0 && (
				<section class="search-photos" aria-labelledby="search-photos-title">
					<h2 id="search-photos-title" class="search-section-title">Kareler</h2>
					<ul>
						{photoHits.map((photo) => (
							<li>
								<a href={"/galeri/" + photo.id}>
									<img src={thumb(photo)} alt="" width="160" height="160" loading="lazy" decoding="async" style={photo.color ? `background-color:${photo.color}` : undefined} />
									<span>{photo.title}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			results.length > 0 && photoHits.length > 0 && <h2 class="search-section-title">Yazılar</h2>
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result) => {
						const thumb = thumbOf(result.image);
						return (
							<li class="search-result">
								<a href={localePath(`/${result.slug ?? result.id}`, locale)} class:list={["result-link", { "has-thumb": thumb }]}>
									{thumb && <img class="result-thumb" src={thumb.src} width={thumb.width} height={thumb.height} alt="" loading="lazy" decoding="async" style={thumb.color ? `background-color:${thumb.color}` : undefined} />}
									<div class="result-body">
										<h2 class="result-title">{result.title ?? t("Başlıksız")}</h2>
										{result.snippet && <p class="result-snippet" set:html={result.snippet} />}
									</div>
								</a>
							</li>
						);
					})}
				</ol>
			)
		}

		{!query && <p class="search-hint">{t("Bir kelime, yer ya da konu yazarak yazılar ve kareler arasında gezinin.")}</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.search-section-title {
		font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
		color: var(--color-muted); font-weight: 500; margin: 0 0 1rem;
	}
	.search-photos { margin-bottom: 2.5rem; }
	.search-photos ul {
		list-style: none; margin: 0; padding: 0;
		display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem;
	}
	.search-photos a { display: grid; gap: 0.45rem; color: var(--color-text); text-decoration: none; font-size: 0.85rem; }
	.search-photos img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); display: block; }
	.search-photos a:hover span { text-decoration: underline; text-underline-offset: 3px; }

	.search-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-6);
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.search-input {
		flex: 1;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	/* Klavye odagi diger girislerle tutarli: 1px kenarlik degisimi yetersizdi. */
	.search-input:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 1px;
		border-color: var(--color-brand);
	}

	.search-button {
		padding: var(--spacing-2) var(--spacing-6);
		font-size: var(--font-size-base);
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 500;
	}

	.search-button:hover {
		opacity: 0.9;
	}

	.search-summary {
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.search-hint {
		color: var(--color-muted);
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.search-result {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	/* Tema sonuclari kart olarak cizer (theme.css); liste ayraci kurallari
	   (ilk kartta ust bosluk 0, son kartta alt kenarlik yok) kartlari bozuyordu. */

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.result-link.has-thumb {
		display: grid;
		grid-template-columns: 176px minmax(0, 1fr);
		gap: 20px;
		align-items: start;
	}

	.result-thumb {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 10px;
	}

	@media (max-width: 600px) {
		.result-link.has-thumb { grid-template-columns: 96px minmax(0, 1fr); gap: 14px; }
	}

	.result-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.result-link:hover .result-title {
		color: var(--color-brand);
	}

	.result-snippet {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* FTS returns <mark> wrapping the matched terms */
	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: inherit;
		padding: 0 0.1em;
		border-radius: 2px;
	}
</style>
