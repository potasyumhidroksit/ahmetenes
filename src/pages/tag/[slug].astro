---
import { decodeSlug } from "emdash";
import TermArchive from "../../components/TermArchive.astro";
import { notFound } from "../../utils/http";
import { localeFromUrl, translate } from "../../utils/i18n";
import { archiveDescription, loadTermArchive } from "../../utils/term-archive";
const locale = localeFromUrl(Astro.url);
const archive = await loadTermArchive("tag", decodeSlug(Astro.params.slug), locale);

if (!archive) {
	return notFound(Astro);
}

if (Astro.cache?.enabled) Astro.cache.set(archive.cacheHint);
const { label } = archive.term;
---

<TermArchive
	archive={archive}
	title={locale === "tr" ? `${label} etiketli yazılar` : `Posts tagged "${label}"`}
	description={locale === "tr" ? archiveDescription(archive, "etiketli") : `All posts tagged with ${label}`}
	label={translate(locale, "Etiket")}
	empty={translate(locale, "Bu etikette henüz yazı yok.")}
/>
